# Static KEY=value file; it is never sourced as shell.
# Only DELEGATE_CODEX_LOG_DIR and CLAUDE_BIN are accepted.
# Local-only logs. Choose a path writable under your Codex permission profile
# and outside every git worktree.
# Default: macOS ~/Library/Logs/delegate-codex
#          Linux ${XDG_STATE_HOME:-~/.local/state}/delegate-codex
DELEGATE_CODEX_LOG_DIR=

# Optional CLI override.
CLAUDE_BIN=
